# ─────────────────────────────────────────────────────────────────────────────
# Raw Sushi Bistro – Payroll Backend Environment Variables
# Copy to .env and fill in real values (never commit .env to git)
# ─────────────────────────────────────────────────────────────────────────────

# Path to the Google service-account JSON key file (kept outside repo)
SERVICE_ACCOUNT_KEY=../secrets/service_account.json

# Google Drive folder where Toast CSV exports are uploaded each period
RAW_FOLDER_ID=1_g5jBpoY54rX22TlLMlubZ4r15tfWhBO

# Google Sheets: one tab per payroll period (MM-DD format)
PAYROLL_FILE_ID=1WSiRuSmhwklWwZ7hAGdtqbFCuaiU6BMbLFrpzy3Df7o

# Google Sheets: admin workbook (Tip Records + Sheet Supper)
ADMIN_FILE_ID=1K1ycBuw2mdqZjWfHGw_DG-T5sYXF8LbWEOAs63lssPk

# Kitchen pool: E89 = E3 × M22 + T30  (E3 = total server VAL, confirmed)
# Set KITCHEN_SERVER_VAL_FRACTION = M22 once owner confirms.
KITCHEN_SERVER_VAL_FRACTION=0.0

# Sushi pool: F3 = E3 × M24 + D123 + sushi_direct_tips
# Set these once owner confirms M24 and D123.
SUSHI_VAL_FRACTION=0.0
SUSHI_D123=0.0

# Sushi-role tip multipliers (G = hours × H). Default 1.0 until confirmed.
SUSHI_MULT_SUSHI=1.0
