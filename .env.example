# ─────────────────────────────────────────────────────────────────────────────
# Raw Sushi Bistro – Payroll Backend Environment Variables
# Copy to .env and fill in real values (never commit .env to git)
# ─────────────────────────────────────────────────────────────────────────────

# Path to the Google service-account JSON key file (kept outside repo)
GOOGLE_SERVICE_ACCOUNT_FILE=../secrets/service_account.json

# ── Source files (Drive IDs or leave blank to auto-discover from folder) ──────
# When both are set, the pipeline uses these specific files.
# When blank, it finds the latest timesheet + orders pair in RAW_FOLDER_ID.
SOURCE_FILE_1_ID=
SOURCE_FILE_2_ID=

# ── Output targets ────────────────────────────────────────────────────────────
OUTPUT_SHEET_ID=1WSiRuSmhwklWwZ7hAGdtqbFCuaiU6BMbLFrpzy3Df7o
OUTPUT_TAB_NAME=Payroll Output
COMPARE_TAB_NAME=Compare With Supper

# ── Sheet Supper (comparison reference) ──────────────────────────────────────
SUPPER_SHEET_ID=1K1ycBuw2mdqZjWfHGw_DG-T5sYXF8LbWEOAs63lssPk
SUPPER_TAB_NAME=Sheet Supper

# ── Google Drive source folder ────────────────────────────────────────────────
RAW_FOLDER_ID=1_g5jBpoY54rX22TlLMlubZ4r15tfWhBO

# ── Legacy IDs (kept for backwards compatibility) ─────────────────────────────
PAYROLL_FILE_ID=1WSiRuSmhwklWwZ7hAGdtqbFCuaiU6BMbLFrpzy3Df7o
ADMIN_FILE_ID=1K1ycBuw2mdqZjWfHGw_DG-T5sYXF8LbWEOAs63lssPk

# ── Kitchen pool formula: E89 = E3 x M22 + T30 ───────────────────────────────
# E3 = $F$77 = SUM(F55:F76) = total server VAL (confirmed)
# Set to M22 cell value once owner confirms.
KITCHEN_SERVER_VAL_FRACTION=0.0

# ── Sushi pool formula: F3 = E3 x M24 + D123 + sushi_direct_tips ─────────────
SUSHI_VAL_FRACTION=0.0
SUSHI_D123=0.0
SUSHI_MULT_SUSHI=1.0
