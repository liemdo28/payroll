# ─────────────────────────────────────────────────────────────────────────────
# Payroll Dashboard – Cloudflare Pages environment variables
# Set these in: Cloudflare Dashboard → Pages → payroll-dashboard → Settings →
#               Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Google Sheets: payroll workbook file ID
PAYROLL_FILE_ID=

# Google Sheets: admin workbook file ID
ADMIN_FILE_ID=

# Service-account JSON (single line, no newlines) – set as a SECRET, not a var
# GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key":"..."}
